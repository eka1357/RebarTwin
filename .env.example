# Copy to .env and fill in. Never commit .env.

# Local development: a Google AI Studio key
GEMINI_API_KEY=

# Cloud Run: Vertex AI instead of the key above
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Cloud Vision, for sheets whose text was exported as lines (OCR)
VISION_API_KEY=

# Models (ARCHITECTURE.md, Reader)
REBARTWIN_MODEL_READ=gemini-3.8-flash
REBARTWIN_MODEL_LINK=gemini-4-argon
REBARTWIN_MODEL_FALLBACK=gemini-3.8-flash

# Storage and reply cache (showcase onward)
REBARTWIN_UPLOAD_BUCKET=
REBARTWIN_REPLIES_DIR=out/_replies
